[project]
name = "{{name}}"
version = "0.1.0"
description = "An HTTP API built with Oxbrook."
requires-python = ">=3.14"
dependencies = ["{{oxbrook}}"]

[dependency-groups]
dev = ["pytest", "httpx"]

[tool.uv]
# An application, not a library: install its dependencies, not the project.
package = false

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]
